#!/bin/bash
#SBATCH --nodes=5
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:4
#SBATCH -p sequana_gpu
#SBATCH -J ds_r1_full
#SBATCH --time=04:00:00

cd $SLURM_SUBMIT_DIR
module load python
module load cudnn

nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
nodes_array=($nodes)
head_node=${nodes_array[0]}
head_node_ip=$(srun --nodes=1 --ntasks=1 -w "$head_node" hostname --ip-address)
port=6379

srun --nodes=1 --ntasks=1 -w "$head_node" ray start --head --node-ip-address="$head_node_ip" --port=$port --block &
sleep 10

for ((i=1; i<${#nodes_array[@]}; i++)); do
  srun --nodes=1 --ntasks=1 -w "${nodes_array[$i]}" ray start --address "$head_node_ip:$port" --block &
done
sleep 10

python test_deepseek_full.py
